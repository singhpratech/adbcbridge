<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>AdbcBridge</RootNamespace>
    <AssemblyName>AdbcBridge</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>AdbcBridge</PackageId>
    <Version>0.1.0</Version>
    <Authors>the adbcbridge authors</Authors>
    <Company>the adbcbridge authors</Company>
    <Copyright>Copyright 2026 the adbcbridge authors</Copyright>
    <Description>Finds and loads adbcbridge, the ADBC driver for any ODBC data source, for Apache.Arrow.Adbc. Driver.Path() locates libadbc_driver_odbc, Driver.Load() imports it, Driver.Connect() opens an ADBC connection from an ODBC connection string.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/singhpratech/adbcbridge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/singhpratech/adbcbridge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>adbc;odbc;arrow;database;sql</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Arrow.Adbc" Version="0.24.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    Native assets. Point NativeRoot at a directory laid out as

        <NativeRoot>/<rid>/libadbc_driver_odbc.{so,dylib,dll}

    (rids: linux-x64, linux-arm64, osx-arm64, win-x64, ...) and every library
    found there is packed under runtimes/<rid>/native/, which is where
    Driver.Path() looks relative to the AdbcBridge assembly. Without NativeRoot
    the package is managed-only and Driver.Path() falls back to the environment,
    the ADBC driver manifest and the usual install directories.
  -->
  <ItemGroup Condition="'$(NativeRoot)' != ''">
    <AdbcBridgeNative Include="$(NativeRoot)/**/libadbc_driver_odbc.so;$(NativeRoot)/**/libadbc_driver_odbc.dylib;$(NativeRoot)/**/libadbc_driver_odbc.dll" />
    <!-- A full file name in PackagePath, or NuGet appends RecursiveDir a second time. -->
    <None Include="@(AdbcBridgeNative)" Pack="true" PackagePath="runtimes/%(RecursiveDir)native/%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="AdbcBridgeCheckNativeRoot" BeforeTargets="GenerateNuspec" Condition="'$(NativeRoot)' != ''">
    <Error Condition="'@(AdbcBridgeNative)' == ''" Text="NativeRoot='$(NativeRoot)' is not a directory laid out as &lt;rid&gt;/libadbc_driver_odbc.{so,dylib,dll}" />
    <Message Importance="high" Text="AdbcBridge: packing %(AdbcBridgeNative.Identity) as runtimes/%(AdbcBridgeNative.RecursiveDir)native/" />
  </Target>

</Project>
