#
# ADBC driver manifest for adbcbridge.  Expanded by CMake at install time and
# installed as <prefix>/etc/adbc/drivers/odbc.toml, so the ADBC driver manager
# can find the driver by the name "odbc".
# Format: https://arrow.apache.org/adbc/current/format/driver_manifests.html

manifest_version = 1

name = 'adbcbridge (ODBC)'
version = '@PROJECT_VERSION@'
publisher = 'the adbcbridge authors'
license = 'Apache-2.0'
url = 'https://adbcbridge.org'

[ADBC]
version = '1.1.0'

[ADBC.features]
supported = [
  'bulk insert',
  'parameter binding',
  'prepared statements',
  'transactions',
  'get objects',
  'get table schema',
  'execute schema',
  'cancel',
]
unsupported = [
  'async',
  'partitioned results',
  'statistics',
]

[Driver]
entrypoint = 'AdbcDriverInit'

# Paths are TOML literal strings (single quotes): no backslash escaping, and
# forward slashes work on Windows too.
[Driver.shared]
@ADBCBRIDGE_MANIFEST_PLATFORM@ = '@ADBCBRIDGE_MANIFEST_DRIVER_PATH@'
